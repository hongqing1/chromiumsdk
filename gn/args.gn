target_os = "android"
target_cpu = "arm64"
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_nacl = false
# Keep link RAM low on 15GB box
use_thin_lto = false
use_siso = false
concurrent_links = 1
ffmpeg_branding = "Chrome"
proprietary_codecs = true
treat_warnings_as_errors = false

# --- Privacy / anti-telemetry (CN store compliance) ---
is_chrome_branded = false
use_official_google_api_keys = false
google_api_key = "invalid"
google_default_client_id = "invalid"
google_default_client_secret = "invalid"

enable_reporting = false
disable_fieldtrial_testing_config = true
safe_browsing_mode = 0

enable_remoting = false
# enable_vr left default: setting false asserts in //device/vr (pulled by chrome/browser)
enable_hangout_services_extension = false
enable_mdns = false
enable_updater = false
enable_widevine = false
enable_silent_java_assert_reporting = false
